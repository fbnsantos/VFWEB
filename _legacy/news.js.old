/* ────────────────────────────────────────────────────────────────
   ViField: página de notícias (news.html)
   ----------------------------------------------------------------
   Lê a lista window.VIFIELD_NEWS (data/news-data.js), ordena por data
   (mais recente primeiro), mostra o destaque (featured: true) e os
   restantes cartões, e cria os filtros por categoria.

   Integração com o back office: basta que a página receba a mesma
   lista com os mesmos campos (ver LEIA-ME.md). Em alternativa, o
   servidor pode gerar este HTML diretamente e este ficheiro deixa
   de ser necessário.
──────────────────────────────────────────────────────────────── */
(function () {
  var LABELS = { press: "Press", announcement: "Announcement", event: "Event" };
  var PLURAL = { press: "Press", announcement: "Announcements", event: "Events" };
  var ORDER = ["press", "announcement", "event"];
  var MONTHS = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  var ARROW = '<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M9 4l4 4-4 4"/></svg>';

  // Texto vindo do back office é sempre escapado antes de entrar no HTML.
  function esc(v) {
    return String(v == null ? "" : v)
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function fmtDate(iso) {
    var d = new Date(iso + "T00:00:00");
    if (isNaN(d.getTime())) return iso || "";
    return d.getDate() + " " + MONTHS[d.getMonth()] + " " + d.getFullYear();
  }

  function cardHTML(it) {
    var label = LABELS[it.category] || it.category || "";
    return '<a class="news-card reveal" data-category="' + esc(it.category) + '" href="' + esc(it.url || "#") + '">'
      + '<div class="news-card-top"><span class="tag">' + esc(label) + '</span>'
      + '<span class="meta-date">' + esc(fmtDate(it.date)) + '</span></div>'
      + '<h3>' + esc(it.title) + '</h3>'
      + '<p>' + esc(it.excerpt) + '</p>'
      + '<div class="news-card-foot"><span class="news-source">' + esc(it.source) + '</span>'
      + '<span class="read-link">Read ' + ARROW + '</span></div></a>';
  }

  function featuredHTML(it) {
    var label = LABELS[it.category] || it.category || "";
    var img = it.image || "images/orioosv2-1.jpeg";
    var badge = it.badge || "Featured";
    return '<a class="featured-card reveal" href="' + esc(it.url || "#") + '">'
      + '<div class="featured-media"><span class="featured-badge">' + esc(badge) + '</span>'
      + '<img src="' + esc(img) + '" alt="' + esc(it.imageAlt || it.title) + '"></div>'
      + '<div class="featured-info"><div class="featured-meta">'
      + '<span class="tag">' + esc(label) + '</span><span class="meta-date">' + esc(fmtDate(it.date)) + '</span></div>'
      + '<h2>' + esc(it.title) + '</h2><p>' + esc(it.excerpt) + '</p>'
      + '<span class="read-link">Read the article ' + ARROW + '</span></div></a>';
  }

  var data = (window.VIFIELD_NEWS || []).slice();
  data.sort(function (a, b) {
    var x = a.date || "", y = b.date || "";
    return x < y ? 1 : x > y ? -1 : 0; // mais recente primeiro
  });

  var featured = null, rest = [];
  data.forEach(function (it) {
    if (!featured && it.featured) featured = it; else rest.push(it);
  });

  var featSection = document.getElementById("featured");
  var featMount = document.getElementById("featuredMount");
  if (featured && featMount) {
    featMount.innerHTML = featuredHTML(featured);
  } else {
    if (featSection) featSection.style.display = "none";
    rest = data.slice();
  }

  var grid = document.getElementById("newsGrid");
  if (grid) grid.innerHTML = rest.map(cardHTML).join("");

  // Filtros (só aparecem quando há mais do que uma categoria)
  var gridCards = grid ? Array.prototype.slice.call(grid.querySelectorAll(".news-card")) : [];
  var countEl = document.getElementById("newsCount");
  var emptyEl = document.getElementById("newsEmpty");
  var controls = document.getElementById("newsControls");
  var toggle = document.getElementById("filterToggle");

  var present = ORDER.filter(function (c) {
    return rest.some(function (it) { return it.category === c; });
  });

  if (toggle && present.length >= 2) {
    var html = '<button class="is-active" data-filter="all" role="tab" aria-selected="true">All</button>';
    present.forEach(function (c) {
      html += '<button data-filter="' + c + '" role="tab" aria-selected="false">' + PLURAL[c] + '</button>';
    });
    toggle.innerHTML = html;
  } else if (controls) {
    controls.style.display = "none";
  }

  var buttons = Array.prototype.slice.call(document.querySelectorAll("#filterToggle [data-filter]"));

  function apply(filter) {
    var shown = 0;
    gridCards.forEach(function (card) {
      var match = filter === "all" || card.getAttribute("data-category") === filter;
      card.classList.toggle("is-hidden", !match);
      if (match) shown++;
    });
    if (countEl) countEl.textContent = shown;
    if (emptyEl) emptyEl.classList.toggle("is-shown", shown === 0);
  }

  buttons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      buttons.forEach(function (b) {
        var active = b === btn;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
      });
      apply(btn.getAttribute("data-filter"));
    });
  });
  apply("all");
})();
